# 至少填一个；不填的 provider 不会被使用
GEMINI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=sk-8c21e873954d4ff5bcec1cf15253e547

# 视觉理解 + 笔记合并用的模型（三选一，写在 VISION_PROVIDER 里）
#   gemini   : VISION_MODEL=deepseek-v4-flash
#   kimi     : VISION_MODEL=deepseek-v4-flash
#   deepseek : VISION_MODEL=deepseek-v4-flash
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-v4-flash

# 本地语音转写模型（faster-whisper，无需 API key）
# 2060 6GB 推荐 medium；显存更紧用 small；想更准用 large-v3（需 ~10GB，2060 跑不动）
WHISPER_MODEL=small
