# 至少填一个；不填的 provider 不会被使用
GEMINI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=sk-8c21e873954d4ff5bcec1cf15253e547

# 视觉理解 + 笔记合并用的模型（三选一，写在 VISION_PROVIDER 里）
#   gemini   : VISION_MODEL=gemini-2.5-flash
#   kimi     : VISION_MODEL=kimi-k3
#   deepseek : 文本模型用 VISION_MODEL，视觉模型用下面的 DEEPSEEK_VISION_MODEL（两者必须分开！）
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-v4-flash            # 文本模型（笔记合并/问答用）
DEEPSEEK_VISION_MODEL=deepseek-vl-chat   # 视觉模型（抽帧图生文用；deepseek-v4-flash 是纯文本不支持图片）

# 本地语音转写模型（faster-whisper，无需 API key）
# 2060 6GB 推荐 medium；显存更紧用 small；想更准用 large-v3（需 ~10GB，2060 跑不动）
WHISPER_MODEL=small
